"LightmappedGeneric"
{
	"%CompileNoLight" "1"

	"$basetexture"			"secret/crystal_green"
	"$envmap"  "secret/crystal_green"
	"$envmaptint" 0.85
	"$envmapcontrast" 1

	"$surfaceprop" "glass"
	"%keywords" "hs"

	"$selfillum" "1"

	"$detail" "detail\shine_detail_01"
	"$detailscale" "1"
	"$detailblendfactor" 1
	"$detailblendmode" 0

	"Proxies"
	{	
		"Sine"
		{
			sinemin 0.65
			sinemax 1.1
			sineperiod 2
			resultVar $color
		}
		"Sine"
		{
			sinemin 0
			sinemax 0.5
			sineperiod 4
			resultVar $detailblendfactor
		}
		"AnimatedTexture"
		{
			"animatedTextureVar" "$detail"
			"animatedTextureFrameNumVar" "$detailframe"
			"animatedTextureFrameRate" 64
		}
	}
}